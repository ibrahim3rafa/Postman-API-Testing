		{
			"name": "List Users",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"\r",
							"\r",
							"\r",
							"// Test the response body structure\r",
							"const response = pm.response.json();\r",
							"pm.test(\"Response body has the correct structure\", function () {\r",
							"    pm.expect(response).to.have.all.keys('page', 'per_page', 'total', 'total_pages', 'data', 'support', '_meta');\r",
							"});\r",
							"\r",
							"// Test the 'data' array\r",
							"pm.test(\"'data' is an array\", function () {\r",
							"    pm.expect(response.data).to.be.an('array');\r",
							"    response.data.forEach(user => {\r",
							"        pm.expect(user).to.have.all.keys('id', 'email', 'first_name', 'last_name', 'avatar');\r",
							"        pm.expect(user.id).to.be.a('number');\r",
							"        pm.expect(user.email).to.be.a('string');\r",
							"        pm.expect(user.first_name).to.be.a('string');\r",
							"        pm.expect(user.last_name).to.be.a('string');\r",
							"        pm.expect(user.avatar).to.be.a('string');\r",
							"        pm.expect(user.avatar).to.match(/^https?:\\/\\//); // Check if avatar URL is valid\r",
							"    });\r",
							"});\r",
							"\r",
							"// Test the 'support' object\r",
							"pm.test(\"'support' object has the correct structure\", function () {\r",
							"    pm.expect(response.support).to.have.all.keys('url', 'text');\r",
							"    pm.expect(response.support.url).to.be.a('string');\r",
							"    pm.expect(response.support.text).to.be.a('string');\r",
							"});\r",
							"\r",
							"// Test the '_meta' object\r",
							"pm.test(\"'_meta' object has the correct structure\", function () {\r",
							"    pm.expect(response._meta).to.have.all.keys('powered_by', 'upgrade_url', 'docs_url', 'template_gallery', 'message', 'features', 'upgrade_cta');\r",
							"    pm.expect(response._meta.powered_by).to.be.a('string');\r",
							"    pm.expect(response._meta.upgrade_url).to.be.a('string');\r",
							"    pm.expect(response._meta.docs_url).to.be.a('string');\r",
							"    pm.expect(response._meta.template_gallery).to.be.a('string');\r",
							"    pm.expect(response._meta.message).to.be.a('string');\r",
							"    pm.expect(response._meta.features).to.be.an('array');\r",
							"    pm.expect(response._meta.upgrade_cta).to.be.a('string');\r",
							"});\r",
							""
						],
